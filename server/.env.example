# Copy to server/.env and adjust. Never commit real values.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Local database (run `npm run db:dev` in another terminal, then `npm run migrate`).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/jobhunter

# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CORS_ORIGIN=http://localhost:5173
STORAGE_DIR=./storage

# Optional AI (Anthropic). Without a key the app uses deterministic drafts and skips AI explanations.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Public job-board APIs for company career pages (comma-separated board tokens / slugs).
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
# RSS or Atom feeds you are allowed to read.
RSS_FEEDS=

# Licensed or partner feeds only. Each must return the Job Hunter JSON feed format described in README.md.
LINKEDIN_FEED_URL=
INDEED_FEED_URL=
NAUKRI_FEED_URL=
INTERNSHALA_FEED_URL=
APNA_FEED_URL=
JOBHAI_FEED_URL=
LICENSED_FEED_API_KEY=

# Offline sample jobs for development and demos.
ENABLE_MOCK_SOURCE=true

# Scheduled searches and follow-up reminders.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000
