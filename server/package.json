{
  "name": "@job-hunter/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outdir=dist",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/db/migrate-cli.ts",
    "db:dev": "tsx src/db/dev-db.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "docx": "^9.0.2",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^4.5.7",
    "fastify": "^5.0.0",
    "jose": "^5.9.6",
    "mammoth": "^1.8.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "unpdf": "^1.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "^17.6.0-beta.15",
    "esbuild": "^0.24.2",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  }
}
